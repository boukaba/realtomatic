# ---------------------------------------------------------------------------
# LLM backend
# ---------------------------------------------------------------------------
# opencode (default) = use the local OpenCode server (see src/lib/opencode.ts).
# openai             = use a direct OpenAI-compatible /chat/completions HTTP API.
REALTOMATIC_LLM_BACKEND=opencode

# ---------------------------------------------------------------------------
# OpenCode backend (used when REALTOMATIC_LLM_BACKEND=opencode)
# ---------------------------------------------------------------------------
# OPENCODE_PROVIDER_ID=opencode-go
# REALTOMATIC_MODEL=deepseek-v4.1-flash
# REALTOMATIC_REASONING=low
# OPENCODE_SERVER_URL=http://127.0.0.1:4098
# REALTOMATIC_OPENCODE_PORT=4098

# ---------------------------------------------------------------------------
# Direct OpenAI-compatible backend (used when REALTOMATIC_LLM_BACKEND=openai)
# ---------------------------------------------------------------------------
# Works with OpenAI, OpenRouter, vLLM, Ollama, LM Studio, LiteLLM, and other
# OpenAI-compatible APIs.
# REALTOMATIC_OPENAI_BASE_URL=https://api.openai.com/v1
# REALTOMATIC_OPENAI_API_KEY=sk-your-key
# Comma-separated models are tried in order (with a 10-minute cooldown on failure).
# REALTOMATIC_OPENAI_MODEL=gpt-4o-mini

# Optional tuning
# REALTOMATIC_OPENAI_TEMPERATURE=0.7
# REALTOMATIC_OPENAI_MAX_TOKENS=4096
# REALTOMATIC_OPENAI_MAX_TOKENS_FIELD=max_tokens
# REALTOMATIC_OPENAI_TIMEOUT_MS=150000
# REALTOMATIC_OPENAI_REASONING_EFFORT=low
# Extra request headers as JSON (e.g. an api-key header for a gateway).
# REALTOMATIC_OPENAI_HEADERS={"api-key":"..."}
# REALTOMATIC_OPENAI_STREAM_USAGE=1
# REALTOMATIC_OPENAI_STREAM_REASONING=0
# REALTOMATIC_OPENAI_HISTORY_MESSAGES=30
# REALTOMATIC_OPENAI_HISTORY_CHARS=60000

# Standard OpenAI names are accepted as fallbacks:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini
